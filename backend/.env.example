# Database - Supabase PostgreSQL
# Runtime URL:
# - Persistent server: Supavisor session pooler, port 5432
# - Serverless/Vercel: Supavisor transaction pooler, port 6543, append ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://prisma.PROJECT_REF:SUPABASE_DB_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Migration URL:
# - Prefer Supabase direct connection for migrations when reachable
# - Otherwise use Supavisor session pooler on port 5432
DIRECT_URL=postgresql://prisma.PROJECT_REF:SUPABASE_DB_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Grok / xAI API
XAI_API_KEY=your_xai_api_key_here
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# S3 / Object Storage (optional for now)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=slashforge-assets
S3_REGION=us-east-1

# Application
NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Slashforge

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001
